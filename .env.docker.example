# Copy to app/.env for local dev or pass these when running docker compose:
#
#   docker compose --env-file .env.docker up --build
#
# Required backend secrets (never commit real values):
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
JWT_SECRET=generate-a-long-random-string
USDA_API_KEY=your_usda_api_key

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Keep the bucket PRIVATE — images are served via the authenticated
# /api/meals/{id}/image endpoint, not a public URL.

# Frontend build arg — URL the browser uses to reach the API
VITE_API_URL=http://localhost:8000
