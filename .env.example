# Store the real file outside this repository, e.g. /etc/platter/production.env.
# Do not commit it. Images must be built and pushed by CI with commit-SHA tags.
BACKEND_IMAGE=ghcr.io/your-org/platter-backend:COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/your-org/platter-frontend:COMMIT_SHA
CLOUDFLARED_VERSION=PINNED_CLOUDFLARED_VERSION
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

# FastAPI / managed-service credentials
DATABASE_URL=postgresql://user:password@pooled-neon-host/neondb?sslmode=require
JWT_SECRET=generate-a-long-random-string
USDA_API_KEY=your_usda_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_private_bucket

# IF NEEDED, UNCOMMENT
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=production
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# VITE_API_URL=

# Set from the upload benchmark. Pool size is per Uvicorn worker.
UVICORN_WORKERS=2
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=3

# Optional Compose resource limits.
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPU_LIMIT=2.0
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5
CLOUDFLARED_MEMORY_LIMIT=128m
CLOUDFLARED_CPU_LIMIT=0.25
