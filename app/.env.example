# Neon Postgres — get from Neon console or: neonctl connection-string --project-id <id>
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Secret for signing JWT access tokens (generate a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# USDA FoodData Central API key
USDA_API_KEY=your_usda_api_key

# Cloudflare R2 (S3-compatible object storage for meal images)
# Create an API token: Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Note: the bucket should stay PRIVATE. Images are served through the
# authenticated /api/meals/{id}/image endpoint, never a public URL.
